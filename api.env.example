# ==========================================
# MarketMind AI - Environment Configuration
# ==========================================
# Copy this file to 'api.env' and fill in your actual values
# DO NOT commit api.env to version control!

# ==========================================
# REQUIRED: AI Provider
# ==========================================
# Get your Nebius API key from: https://studio.nebius.ai/
# This is required for LLM analysis generation
NEBIUS_API_KEY=your_nebius_api_key_here

# ==========================================
# REQUIRED: Web Scraping Service
# ==========================================
# Get your ScrapeGraph API key from: https://dashboard.scrapegraph.ai/
# This is required for SmartCrawler and SearchScraper
SMARTCRAWLER_API_KEY=your_scrapegraph_api_key_here

# ==========================================
# REQUIRED: Redis Configuration
# ==========================================
# Redis is used for caching and rate limiting
# 
# Local Development:
#   REDIS_URL=redis://localhost:6379/0
#
# Docker:
#   REDIS_URL=redis://redis:6379/0
#
# Redis Cloud (production):
#   REDIS_URL=redis://:password@host:port/0
#
# AWS ElastiCache:
#   REDIS_URL=redis://cache-cluster.example.com:6379/0
REDIS_URL=redis://localhost:6379/0

# ==========================================
# OPTIONAL: Rate Limiting Configuration
# ==========================================
# Control how many requests users can make
# These limits help prevent abuse and ensure fair usage

# Max requests per user per minute (default: 3)
RATE_LIMIT_PER_USER=3

# Max platform-wide requests per minute (default: 200)
RATE_LIMIT_PLATFORM=200

# ==========================================
# OPTIONAL: Cache Configuration
# ==========================================
# Control how long analysis results are cached

# Cache time-to-live in days (default: 7)
# After this period, cached results expire and requests
# trigger fresh analysis
CACHE_TTL_DAYS=7

# ==========================================
# Notes:
# ==========================================
# 1. All values above are defaults shown for reference
# 2. You only need to set NEBIUS_API_KEY, SMARTCRAWLER_API_KEY, and REDIS_URL
# 3. Leave optional values commented to use defaults
# 4. For production, use environment variables instead of this file
# 5. Ensure api.env is in your .gitignore file